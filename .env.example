# 生产环境变量示例 —— 在云平台的「环境变量」后台填写，不要提交真实密钥到仓库
# 生成强密钥：python -c "import secrets;print(secrets.token_urlsafe(50))"

# Django 密钥（必填，生产必须替换为随机强密钥）
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# 是否调试模式（生产务必 False）
DJANGO_DEBUG=False

# 允许访问的域名（逗号分隔，可填平台分配的域名 + 你自己的域名）
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库：默认使用项目内 SQLite（db.sqlite3）。如需 Postgres，请改为 DATABASE_URL 方式连接。
